# LLM Provider
# 可选: openai / anthropic / ollama / opencode
# 默认 openai（OpenAI 兼容接口，也适用于 AMD Radeon 等）
LLM_PROVIDER=openai
# 前端显示的友好名称（如 AMD Radeon / DeepSeek / OpenCode Zen），留空则显示 provider 名
LLM_PROVIDER_LABEL=

# OpenAI（OpenAI 兼容接口，可填 OpenAI 官方或 AMD Radeon 等）
OPENAI_API_KEY=sk-your-key-here
# OpenAI 兼容接口地址（官方留空即可；AMD Radeon 等需填写）
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama（本地）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenCode Zen（可选，需显式配置才会出现在前端下拉列表，无代码硬编码默认）
OPENCODE_API_KEY=sk-your-opencode-key-here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free

# 自定义模型（前端配置，可覆盖以上）
# 支持的国产模型:
#   DeepSeek:  https://api.deepseek.com/v1
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱GLM:   https://open.bigmodel.cn/api/paas/v4
#   Kimi:      https://api.moonshot.cn/v1
#   豆包:      https://ark.cn-beijing.volces.com/api/v3
#   文心:      https://qianfan.baidubce.com/v2
#   MiniMax:   https://api.minimax.chat/v1
#   百川:      https://api.baichuan-ai.com/v1
#   腾讯混元:  https://api.hunyuan.cloud.tencent.com/v1
#   零一万物:  https://api.lingyiwanwu.com/v1
#   硅基流动:  https://api.siliconflow.cn/v1

# Database
DATABASE_URL=sqlite:///./novel_generator_v1.db

# Server
HOST=0.0.0.0
PORT=8000
