{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/Users/snow/snow-pro/novel-generator"]
    }
  },
  "instructions": [
    ".mimocode/rules/**/*.md"
  ],
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/Users/snow/snow-pro/novel-generator/**": "allow"
    }
  }
}
