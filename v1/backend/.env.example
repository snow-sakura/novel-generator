# LLM Provider
LLM_PROVIDER=opencode

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama（本地）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenCode Zen（免费）
OPENCODE_API_KEY=sk-your-opencode-key-here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free

# 自定义模型（前端配置，可覆盖以上）
# 支持的国产模型:
#   DeepSeek:  https://api.deepseek.com/v1
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱GLM:   https://open.bigmodel.cn/api/paas/v4
#   Kimi:      https://api.moonshot.cn/v1
#   豆包:      https://ark.cn-beijing.volces.com/api/v3
#   文心:      https://qianfan.baidubce.com/v2
#   MiniMax:   https://api.minimax.chat/v1
#   百川:      https://api.baichuan-ai.com/v1
#   腾讯混元:  https://api.hunyuan.cloud.tencent.com/v1
#   零一万物:  https://api.lingyiwanwu.com/v1
#   硅基流动:  https://api.siliconflow.cn/v1

# Database
DATABASE_URL=sqlite:///./novel_generator_v1.db

# Server
HOST=0.0.0.0
PORT=8000
